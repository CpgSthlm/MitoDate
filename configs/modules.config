process {
    // RENAMEFASTA
    withName: 'RENAMEFASTA' {
        publishDir = [
            path: { "${params.outdir}/01_fastas/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // SPLITFASTA
    withName: 'SPLITFASTA' {
        publishDir = [
            path: { "${params.outdir}/01_fastas/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // GENERATEXML
    withName: 'GENERATEXML' {
        publishDir = [
            path: { "${params.outdir}/02_xml/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // BEAST
    withName: 'BEAST' {
        publishDir = [
            path: { "${params.outdir}/03_beast/run_${new java.time.LocalDateTime.now().format('yyyy-MM-dd_HH-mm-ss')}/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // BEAST_LOG_PARSER
    withName: 'BEAST_LOG_PARSER' {
        publishDir = [
            path: { "${params.outdir}/04_beast_log_parser/run_${new java.time.LocalDateTime.now().format('yyyy-MM-dd_HH-mm-ss')}/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // COLLECT_RESULTS
    withName: 'COLLECT_RESULTS' {
        publishDir = [
            path: { "${params.outdir}/05_age_summary/run_${new java.time.LocalDateTime.now().format('yyyy-MM-dd_HH-mm-ss')}/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}