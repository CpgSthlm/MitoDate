process {

    ///////////////////////////////////////////////////////////////////////////////////////////////
    // MODE 1 and 2: main workflow and re-run beast for samples
    ///////////////////////////////////////////////////////////////////////////////////////////////

    // RENAMEFASTA
    withName: 'RENAMEFASTA' {
        publishDir = [
            path: { "${params.outdir}/01_fastas/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // SPLITFASTA
    withName: 'SPLITFASTA' {
        publishDir = [
            path: { "${params.outdir}/01_fastas/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // GENERATEXML
    withName: 'GENERATEXML' {
        cache = params.run_mode == 'rerun_samples' ? false : true
        publishDir = [
            path: { "${params.outdir}/02_xml/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // BEAST_TIP_DATING
    withName: 'BEAST_TIP_DATING' {
        cache = params.run_mode == 'rerun_samples' ? false : true
        publishDir = [
            path: { "${params.outdir}/03_beast/run_${params.workflow_timestamp}/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // BEAST_LOG_PARSER
    withName: 'BEAST_LOG_PARSER' {
        cache = params.run_mode == 'rerun_samples' ? false : true
        publishDir = [
            path: { "${params.outdir}/04_beast_log_parser/run_${params.workflow_timestamp}/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // COLLECT_RESULTS
    withName: 'COLLECT_RESULTS' {
        cache = params.run_mode == 'rerun_samples' ? false : true
        publishDir = [
            path: { "${params.outdir}/05_age_summary/run_${params.workflow_timestamp}/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    ////////////////////////////////////////////////////////////////////////////////////////////////
    // MODE 3: Time calibrate a fixed tree with BEAST
    ////////////////////////////////////////////////////////////////////////////////////////////////


    // JOINT_TREE_META
    withName: 'JOINT_TREE_META' {
        publishDir = [
            path: { "${params.outdir}/06_final_tree/01_joint_meta/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // JOINT_XML — BEAST XML for the joint tree (no priors table)
    withName: 'JOINT_XML' {
        publishDir = [
            path: { "${params.outdir}/06_final_tree/02_xml/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // BEAST_JOINT_TREE — BEAST run for the joint dated tree
    withName: 'BEAST_JOINT_TREE' {
        publishDir = [
            path: { "${params.outdir}/06_final_tree/03_beast/run_${params.workflow_timestamp}/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // TREE_ANNOTATOR — summarise posterior tree sample into one MCC tree
    withName: 'TREE_ANNOTATOR' {
        publishDir = [
            path: { "${params.outdir}/06_final_tree/04_tree_annotator/run_${params.workflow_timestamp}/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // JOINT_TREE_VISUALIZE — plot the annotated tree
    withName: 'JOINT_TREE_VISUALIZE' {
        publishDir = [
            path: { "${params.outdir}/06_final_tree/05_tree_plot/run_${params.workflow_timestamp}/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}