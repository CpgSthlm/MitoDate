// Nextflow configuration file

manifest {
    name                      = 'MitoChronos'
    author                    = 'Bilal Sharif, Vanssy Li'
    homePage                  = ''
    description               = ''
    mainScript                = 'main.nf'
    //  '!>=23.04.1' : Run with version 23.04.1 or higher, otherwise exit.
    nextflowVersion           = '!>=23.04.1'
    version                   = '0.1'
}

// Default pipeline parameters
// Override them in configs/custom.config
params {
    // INPUT FILES

    // Enter full path to the fasta file with multiple sequenced aligment
    fasta       = '/cfs/klemming/projects/snic/sllstore2017093/mammoth/bilal/mitogenome_dating_pipeline/test_dataset/VDP2021.datedsamples.yuka.aligned.fasta'

    // Enter ful path to the annotatio gff file
    gff         = '/cfs/klemming/projects/snic/sllstore2017093/mammoth/bilal/mitogenome_dating_pipeline/test_dataset/NC_007596.2.VDP2021-yuka.gff3'

    // Enter full path to the priors table file in csv format
    priors      = '/cfs/klemming/projects/snic/sllstore2017093/mammoth/bilal/mitogenome_dating_pipeline/test_dataset/priors.yuka.uniform.csv'

    // Enter full path to the partition file in xx format
    partition   = '/cfs/klemming/projects/snic/sllstore2017093/mammoth/bilal/mitogenome_dating_pipeline/test_dataset/partitions.xlsx'

    // Pipeline steps to be run (comma-separated list, full list: 'single_sample_dating,generate_XML,run_beast')
    steps       = 'single_sample_dating,generate_XML,run_beast'




    // PARAMETERS

    // Enter the number of MCMC chain length for BEAST
    chainlength     = '10000'

    // Enter the number
    log_step        = '1000'

    // Enter partition list. e.g., "tRNA, rRNA, CDS, D_loop"
    partition_list  = '"tRNA, rRNA, CDS, D_loop"'

    // Enter no-dated list. e.g., "ND, P."
    nd_list       = '"ND, P."'

    //Enter taxon set. e.g., "(L., P.), (M.), (M., E.), (ND, P.)"
    taxon_set = '"(L., P.), (M.), (M., E.), (ND, P.)"'



    // OUTPUTS
    // Enter path to output directory
    outdir             = 'results'

    // Mode of copying results from the work directory, values 'symlink' or 'copy'
    publish_mode       = 'copy'
}

// Module- (tool-)specific parameter configurations
// If required, override tool-specific parameters here using process selectors,
// i.e. the same syntax as in 'configs/modules.config'
includeConfig 'configs/modules.config'

// Profiles for pipeline execution

profiles {

    conda {
        conda.enabled         = true
    }

    mamba {
        conda.enabled         = true
        conda.useMamba        = true
    }

    docker {
        docker.enabled        = true
        docker.userEmulation  = true
    }

    singularity {
        singularity.enabled   = true
    }

    execution_report {
        timeline {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_timeline.html"
        }
        report {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_report.html"
        }
        trace {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_trace.txt"
        }
        dag {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/pipeline_dag.mmd"
        }
    }

    // Test profiles
    test {
        params {
            samplesheet       = null
            reference         = null
        }
    }

    // A profile for the PDC cluster Dardel
    dardel {
        includeConfig 'configs/dardel.config'
    }
}

// limit resources for test runs with small dataset
process {

    cpus   = 1
    memory = 6.GB
    time   = 1.h

    withLabel: process_single {
        cpus   = 1
        memory = 6.GB
        time   = 1.h
    }
    withLabel: process_low {
        cpus   = 2
        memory = 6.GB
        time   = 1.h
    }
    withLabel: process_medium {
        cpus   = 2
        memory = 6.GB
        time   = 1.h
    }
    withLabel: process_high {
        cpus   = 2
        memory = 6.GB
        time   = 2.h
    }
    withLabel: process_long {
        time   = 1.h
    }
    withLabel: process_high_memory {
        memory = 6.GB
    }
}