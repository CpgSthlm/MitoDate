// Nextflow configuration file

manifest {
    name                      = 'MitoDate'
    author                    = 'Bilal Sharif, Vanssy Li'
    homePage                  = 'https://github.com/CpgSthlm/MitoDate'
    description               = 'Nextflow pipeline to perform molecular clock dating of ancient mitochondrial genomes using BEAST1'
    mainScript                = 'main.nf'
    nextflowVersion           = '!>=25.10.0'
    version                   = '0.2.1'
}

// Default pipeline parameters
// Override them in configs/custom.config
params {
    workflow_run_name           = ''
    workflow_timestamp          = new Date().format('yyyy-MM-dd_HH-mm-ss')
    run_mode                    = ''  // tip_dating, rerun_samples, joint_tree
    rerun_samples               = null  // e.g. 'sample1,sample2'
    age_summary_file            = null

    /////////////////////////////////////////////////////////////////
    // RUN MODE
    /////////////////////////////////////////////////////////////////

    // Choose which pipeline mode to run.
    // options: 'tip_dating', 'rerun_samples', 'joint_tree'
    // 'tip_dating': Tip-dating workflow for all the samples.
    // This prepares FASTA files, generates XML files, runs BEAST,
    // and collects the dating results into a summary table.
    // 'rerun_samples': Rerun tip-dating only for selected sample
    // IDs using FASTA files already created by a previous tip_dating
    // run. This is useful if only a few samples need to be rerun.
    // 'joint_tree': Build a joint date-calibrated tree after reviewing
    // tip_dating results.

    run_mode        = ''

    /////////////////////////////////////////////////////////////////
    // INPUT FILES
    /////////////////////////////////////////////////////////////////

    // Path to the sample metadata file (tab-delimited .tsv).
    // A template is provided in the `assets/` folder.
    // Required columns:
    //   Sample_ID      - Unique sample identifier.
    //   Species        - Species name of the sample.
    //   Origin         - (Optional) Locality information of the sample.
    //   Group-By       - Taxonomic group used for downstream analysis.
    //   Calibrated_yBP - Sample age in years before present, or `ND` if undated.
    //   TipDating      - `Y` to include the sample in tip dating, `N` to exclude.

    sample_metadata = ''

    // Path to the multiple sequence alignment (MSA) in FASTA format.

    fasta = ''

    // Path to the priors table (CSV format).
    // A template is provided in the `assets/` folder.
    // Required columns:
    //   taxa   - Sample ID (must match `Sample_ID` in the metadata).
    //   date   - Approximate sample age (years before present) used to
    //              initialise the Bayesian chain.
    //   prior  - Type of prior distribution: `uniform`, `lognormal`, or `normal`.
    //   param1 - First parameter of the prior:
    //                `uniform`           -> lower bound
    //                `lognormal`/`normal`-> mean (`mu`)
    //   param2 - Second parameter of the prior:
    //                `uniform`           -> upper bound
    //                `lognormal`/`normal`-> standard deviation (`sigma`)
    //   offset - Offset applied to the distribution (default: 0).

    priors = ''

    // ----- Optional input files -----
    // Path to the annotation GFF file (required only when partitioning is enabled).
    // This gff file should be aligned with the MSA.

    gff = ''

    /////////////////////////////////////////////////////////////////
    // MODE-SPECIFIC INPUTS
    /////////////////////////////////////////////////////////////////

    // ONLY Mode 2: rerun_samples
    // Provide comma-separated sample IDs to rerun,
    // Example: "sample1,sample2,sample3"

    rerun_samples       = ''

    // ONLY Mode 3: joint_tree
    // Provide path to Results_ageSummary.csv from a previous run.

    age_summary_file    = ''

    // Provide figure dimensions (width height in inches) for the
    // tree visualisation.

    figsize_w               = 12
    figsize_h               = 12

    /////////////////////////////////////////////////////////////////
    // PARAMETERS
    /////////////////////////////////////////////////////////////////

    // Select whether to TipDating multiple samples or single sample
    // Options: true; false

    single_sample_dating    = ''

    // Enter whether to split the partition
    // Options: true; false

    split_partition         = ''

    // Substitution Model
    // Substitution models describe how DNA sequences evolve by
    // modeling the rates at which one nucleotide is replaced by another over time.
    // Options: HKY, GTR.
    // Optional rate-heterogeneity modifiers (can be combined):
    //   +I - proportion of invariant sites
    //   +G - gamma-distributed rate variation
    // Example (single partition): 'HKY+G+I'
    //
    // Note: when 'split_partition' is enabled, provide one model per
    // partition as a comma-separated 'partition:model' list, e.g.:
    //   'tRNA:HKY+G+I, rRNA:HKY+G+I, CDS:HKY+G+I, D_loop:HKY+G'

    substitution_model      = ''

    // Root calibration
    // Prior on the divergence time (in years) to the most recent common
    // ancestor (MRCA) of all samples in the alignment. This calibrates
    // the time scale of the tree, and is typically informed by
    // the split time from a sister species reported in the literature.
    //
    // root_mean   - mean of the prior distribution on the root age.
    // root_stdev  - standard deviation of the prior distribution.
    // root_offset - minimum age (offset) of the root.

    root_mean               = ''
    root_stdev              = ''
    root_offset             = ''

    // Population (tree) model.
    // Coalescent prior describing how lineages branch through time, i.e.
    // the shape of the underlying population history assumed by BEAST.
    // Options:
    //   skygrid - non-parametric Bayesian Skygrid model that allows
    //               population size to vary flexibly across time intervals.
    population_model        = ''

    // Molecular clock model.
    // Describes how substitution rates vary across branches of the tree.
    // Options:
    //   strict  - a single, constant substitution rate shared by all branches.

    clock_model             = ''


    // Bayesian MCMC settings
    // chain_length - total number of MCMC iterations to run.
    //                  Longer chains improve convergence but cost more time.
    //                  Example: 100000000
    // log_every    - sampling frequency: log parameters and trees every
    //                  N iterations.
    //                  Example: 10000
    // burnin       - fraction of the chain (in percent) to discard as
    //                  burn-in when summarising results.
    //                  Example: 10 (the first 10% of the chain is removed.)

    chain_length            = ''
    log_every               = ''
    burnin                  = ''

    /////////////////////////////////////////////////////////////////
    // OUTPUTS
    /////////////////////////////////////////////////////////////////

    // Enter path to output directory
    outdir             = 'results'

    // Mode of copying results from the work directory, values 'symlink' or 'copy'
    publish_mode       = 'copy'

    // Process error strategy for Nextflow tasks
    // Options: 'terminate', 'finish', 'ignore', 'retry'
    process_errorStrategy  = 'ignore'
}

// Module- (tool-)specific parameter configurations
// If required, override tool-specific parameters here using
// process selectors, i.e. the same syntax as in
// 'configs/modules.config'
includeConfig 'configs/modules.config'

// Nextflow parameters

// Path to work directory for intermediate files
workDir                    = 'work'

// Execute the script using the cached results, useful to continue
// executions that was stopped by an error.
resume                     = true

// If run with -profile conda or -profile mamba, provide path to
// centralized directory with conda environments
conda.cacheDir             = null

// If run with -profile apptainer, provide path to centralized
// directory with apptainer images
apptainer.cacheDir         = null

// Cluster options
params.clusterOptions      = ''

// Compute project ID for HPC cluster (added to -A option for SLURM)
params.project             = ''


// setup the error strategy

process {
    errorStrategy = params.process_errorStrategy
}

// Profiles for pipeline execution

profiles {

    conda {
        conda.enabled         = true
    }

    mamba {
        conda.enabled         = true
        conda.useMamba        = true
    }

    docker {
        docker.enabled        = true
        docker.userEmulation  = true
    }

    singularity {
        singularity.enabled   = true
    }

    apptainer {
        apptainer.enabled     = true
    }

    // A profile for the PDC cluster Dardel
    dardel {
        includeConfig 'configs/dardel.config'
    }

    // A profile for the PDC cluster Mjolnir
    mjolnir {
        includeConfig 'configs/mjolnir.config'
    }

    // A profile for the PDC cluster Dardel
    dardel_test {
        includeConfig 'configs/dardel_test.config'
    }

    execution_report {
        timeline {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_timeline.html"
        }
        report {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_report.html"
        }
        trace {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_trace.txt"
        }
        dag {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/pipeline_dag.mmd"
        }
    }
}

