// Nextflow configuration file

manifest {
    name                      = 'MitoDate'
    author                    = 'Bilal Sharif, Vanssy Li'
    homePage                  = ''
    description               = ''
    mainScript                = 'main.nf'
    //  '!>=25.10.0' : Run with version 25.10.0 or higher, otherwise exit.
    nextflowVersion           = '!>=25.10.0'
    version                   = '0.1'
}

// Default pipeline parameters
// Override them in configs/custom.config
params {
    workflow_run_name           = 'test'
    workflow_timestamp          = new Date().format('yyyy-MM-dd_HH-mm-ss')

    /////////////////////////////////////////////////////////////////
    // INPUT FILES
    /////////////////////////////////////////////////////////////////

    // Enter path to the sample metadata file (tab-delimited text file).
    sample_metadata = '/cfs/klemming/projects/snic/sllstore2017093/mammoth/bilal/mitogenome_dating_pipeline/test_dataset_2/PolarBearsMetadata.txt'

    // Enter path to the fasta file with multiple sequenced aligment
    fasta = '/cfs/klemming/projects/snic/sllstore2017093/mammoth/bilal/mitogenome_dating_pipeline/test_dataset_2/PolarBears_10x.final_5outgroup.mafft.VNTRexluded.fasta'

    // Enter path to the priors table file in csv format
    priors = '/cfs/klemming/projects/snic/sllstore2017093/mammoth/bilal/mitogenome_dating_pipeline/test_dataset_2/PB_priors-uniform.csv'

    // Optional files
    // Enter path to the annotation gff file - if partition is enabled
    gff = ''

    /////////////////////////////////////////////////////////////////
    // WORKFLOW STEPS
    /////////////////////////////////////////////////////////////////

    // Pipeline steps to be run
    fasta_processing        = ''
    generate_XML            = ''
    run_beast               = ''

    /////////////////////////////////////////////////////////////////
    // PARAMETERS
    /////////////////////////////////////////////////////////////////

    // Select whether to TipDating multiple sample or single sample
    single_sample_dating    = ''

    // Enter whether to split the partition
    split_partition         = ''

    // Substitution model (available options: HKY and GTR)
    // Note: if split_partition is enabled, substitution_model has to provided for each partition separated by comma e.g.,
    // ("tRNA:HKY+G+I, rRNA:HKY+G+I, CDS:HKY+G+I, D_loop:HKY+G")
    substitution_model      = ''

    // Enter mean for the divergence time to the MRCA
    root_mean               = ''

    // Enter standard deviation for the divergence time to the MRCA
    root_stdev              = ''

    // Enter the number of MCMC chain length for BEAST
    chain_length            = ''

    // Enter how often to log the MCMC progress
    log_every               = ''

    // Population models - (options: skygrid)
    population_model        = ''

    // Clock Model - (options: strict)
    clock_model             = ''

    // Enter minimum root offset
    root_offset             = ''

    // Enter burnin for parsing the BEAST log files
    burnin                  = ''


    /////////////////////////////////////////////////////////////////
    // OUTPUTS
    /////////////////////////////////////////////////////////////////

    // Enter path to output directory
    outdir             = 'results'

    // Mode of copying results from the work directory, values 'symlink' or 'copy'
    publish_mode       = 'copy'
}

// Module- (tool-)specific parameter configurations
// If required, override tool-specific parameters here using
// process selectors, i.e. the same syntax as in
// 'configs/modules.config'
includeConfig 'configs/modules.config'

// Nextflow parameters

// Path to work directory for intermediate files
workDir                    = 'work'

// Execute the script using the cached results, useful to continue
// executions that was stopped by an error.
resume                     = true

// If run with -profile conda or -profile mamba, provide path to
// centralized directory with conda environments
conda.cacheDir             = null

// If run with -profile apptainer, provide path to centralized
// directory with apptainer images
apptainer.cacheDir         = null

// Cluster options
params.clusterOptions      = ''

// Compute project ID for HPC cluster
params.project             = ''


// Profiles for pipeline execution

profiles {

    conda {
        conda.enabled         = true
    }

    mamba {
        conda.enabled         = true
        conda.useMamba        = true
    }

    docker {
        docker.enabled        = true
        docker.userEmulation  = true
    }

    singularity {
        singularity.enabled   = true
    }

    apptainer {
        apptainer.enabled     = true
    }

    // A profile for the PDC cluster Dardel
    dardel {
        includeConfig 'configs/dardel.config'
    }

    // A profile for the PDC cluster Mjolnir
    mjolnir {
        includeConfig 'configs/mjolnir_copenhagen.config'
    }

    // A profile for the PDC cluster Dardel
    dardel_test {
        includeConfig 'configs/dardel_test.config'
    }

    execution_report {
        timeline {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_timeline.html"
        }
        report {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_report.html"
        }
        trace {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_trace.txt"
        }
        dag {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/pipeline_dag.mmd"
        }
    }
}

// limit resources for test runs with small dataset
process {

    cpus   = 1
    memory = 6.GB
    time   = 1.h

    withLabel: process_single {
        cpus   = 1
        memory = 6.GB
        time   = 1.h
    }
    withLabel: process_low {
        cpus   = 2
        memory = 6.GB
        time   = 1.h
    }
    withLabel: process_medium {
        cpus   = 2
        memory = 6.GB
        time   = 1.h
    }
    withLabel: process_high {
        cpus   = 2
        memory = 6.GB
        time   = 2.h
    }
    withLabel: process_long {
        time   = 1.h
    }
    withLabel: process_high_memory {
        memory = 6.GB
    }
}