// Nextflow configuration file

manifest {
    name                      = 'MitoDate'
    author                    = 'Bilal Sharif, Vanssy Li'
    homePage                  = 'https://github.com/CpgSthlm/MitoDate'
    description               = 'Nextflow pipeline to perform molecular clock dating of ancient mitochondrial genomes using BEAST'
    mainScript                = 'main.nf'
    nextflowVersion           = '!>=25.10.0'
    version                   = '0.2.1'
}

// Default pipeline parameters
// Override them in configs/custom.config
params {
    workflow_run_name           = ''
    workflow_timestamp          = new Date().format('yyyy-MM-dd_HH-mm-ss')
    run_mode                    = ''  // tip_dating, rerun_samples, joint_tree
    rerun_samples               = null  // e.g. 'sample1,sample2'
    age_summary_file            = null

    /////////////////////////////////////////////////////////////////
    // RUN MODE
    /////////////////////////////////////////////////////////////////

    // Choose which pipeline mode to run.
    // options: 'tip_dating', 'rerun_samples', 'joint_tree'
    // 'tip_dating': Tip-dating workflow for all the samples.
    // This prepares FASTA files, generates XML files, runs BEAST,
    // and collects the dating results into a summary table.
    // 'rerun_samples': Rerun tip-dating only for selected sample
    // IDs using FASTA files already created by a previous tip_dating
    // run. This is useful if only a few samples need to be rerun.
    // 'joint_tree': Build a joint date-calibrated tree after reviewing
    // tip_dating results.
    run_mode        = ''

    /////////////////////////////////////////////////////////////////
    // INPUT FILES
    /////////////////////////////////////////////////////////////////

    // Enter path to the sample metadata file (tab-delimited text file).
    sample_metadata = ''

    // Enter path to the fasta file with multiple sequenced alignment
    fasta = ''

    // Enter path to the priors table file in csv format
    priors = ''

    // Optional files
    // Enter path to the annotation gff file - if partition is enabled
    gff = ''

    /////////////////////////////////////////////////////////////////
    // MODE-SPECIFIC INPUTS
    /////////////////////////////////////////////////////////////////

    // ONLY Mode 2: rerun_samples
    // Provide comma-separated sample IDs to rerun,
    // Example: "sample1,sample2,sample3"
    rerun_samples       = ''

    // ONLY Mode 3: joint_tree
    // Provide path to Results_ageSummary.csv from a previous run.
    age_summary_file    = ''

    // Provide figure dimensions (width height in inches) for the
    // tree visualisation.
    figsize_w               = 12
    figsize_h               = 12

    /////////////////////////////////////////////////////////////////
    // PARAMETERS
    /////////////////////////////////////////////////////////////////

    /////////////////////////////////////////////////////////////////
    // PARAMETERS
    /////////////////////////////////////////////////////////////////

    // Select whether to TipDating multiple samples or single sample
    single_sample_dating    = ''

    // Enter whether to split the partition
    split_partition         = ''

    // Substitution model (available options: HKY and GTR)
    // Note: if split_partition is enabled, substitution_model has
    // to be provided for each partition separated by comma e.g.,
    // ("tRNA:HKY+G+I, rRNA:HKY+G+I, CDS:HKY+G+I, D_loop:HKY+G")
    substitution_model      = ''

    // Enter mean for the divergence time to the MRCA
    root_mean               = ''

    // Enter standard deviation for the divergence time to the MRCA
    root_stdev              = ''

    // Enter the number of MCMC chain length for BEAST
    chain_length            = ''

    // Enter how often to log the MCMC progress
    log_every               = ''

    // Population models - (options: skygrid)
    population_model        = ''

    // Clock Model - (options: strict, relaxed)
    clock_model             = ''

    // Enter minimum root offset
    root_offset             = ''

    // Enter burnin for parsing the BEAST log files
    burnin                  = ''

    /////////////////////////////////////////////////////////////////
    // OUTPUTS
    /////////////////////////////////////////////////////////////////

    // Enter path to output directory
    outdir             = 'results'

    // Mode of copying results from the work directory, values 'symlink' or 'copy'
    publish_mode       = 'copy'
}

// Module- (tool-)specific parameter configurations
// If required, override tool-specific parameters here using
// process selectors, i.e. the same syntax as in
// 'configs/modules.config'
includeConfig 'configs/modules.config'

// Nextflow parameters

// Path to work directory for intermediate files
workDir                    = 'work'

// Execute the script using the cached results, useful to continue
// executions that was stopped by an error.
resume                     = true

// If run with -profile conda or -profile mamba, provide path to
// centralized directory with conda environments
conda.cacheDir             = null

// If run with -profile apptainer, provide path to centralized
// directory with apptainer images
apptainer.cacheDir         = null

// Cluster options
params.clusterOptions      = ''

// Compute project ID for HPC cluster
params.project             = ''


// Profiles for pipeline execution

profiles {

    conda {
        conda.enabled         = true
    }

    mamba {
        conda.enabled         = true
        conda.useMamba        = true
    }

    docker {
        docker.enabled        = true
        docker.userEmulation  = true
    }

    singularity {
        singularity.enabled   = true
    }

    apptainer {
        apptainer.enabled     = true
    }

    // A profile for the PDC cluster Dardel
    dardel {
        includeConfig 'configs/dardel.config'
    }

    // A profile for the PDC cluster Mjolnir
    mjolnir {
        includeConfig 'configs/mjolnir_copenhagen.config'
    }

    // A profile for the PDC cluster Dardel
    dardel_test {
        includeConfig 'configs/dardel_test.config'
    }

    execution_report {
        timeline {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_timeline.html"
        }
        report {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_report.html"
        }
        trace {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_trace.txt"
        }
        dag {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/pipeline_dag.mmd"
        }
    }
}

