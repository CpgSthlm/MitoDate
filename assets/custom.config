// Template file for pipeline configuration

// Pipeline parameters

params {
    workflow_run_name           = 'test'

    /////////////////////////////////////////////////////////////////
    // RUN MODE
    /////////////////////////////////////////////////////////////////

    // Choose which pipeline mode to run.
    // full_tip_dating: Full tip-dating workflow. This prepares FASTA files,
    //                  generates XML files, runs BEAST, and parses the dating results.
    // rerun_tip_dating: Rerun tip-dating only for selected sample IDs using FASTA files
    //                   already created by a previous full_tip_dating run.
    //                   Useful if only a few samples need to be rerun.
    // joint_tree: Build a joint date-calibrated tree after reviewing
    //             full_tip_dating results. This uses the age summary file from
    //             a previous run to date all samples in a final combined tree.
    run_mode                    = 'full_tip_dating'

    /////////////////////////////////////////////////////////////////
    // INPUT FILES
    /////////////////////////////////////////////////////////////////

    // Enter path to the sample metadata file (tab-delimited text file).
    sample_metadata = '/cfs/klemming/projects/snic/sllstore2017093/mitodate/test_dataset_2/PolarBearsMetadata.txt'

    // Enter path to the fasta file with multiple sequenced aligment
    fasta = '/cfs/klemming/projects/snic/sllstore2017093/mitodate/test_dataset_2/PolarBears_10x.final_5outgroup.mafft.VNTRexluded.fasta'

    // Enter path to the priors table file in csv format
    priors = '/cfs/klemming/projects/snic/sllstore2017093/mitodate/test_dataset_2/PB_priors-uniform.csv'

    // Optional files
    // Enter path to the annotation gff file - if partition is enabled
    gff = ''

    /////////////////////////////////////////////////////////////////
    // MODE-SPECIFIC INPUTS
    /////////////////////////////////////////////////////////////////

    // rerun_tip_dating mode only: comma-separated sample IDs to rerun, for example:
    // rerun_tip_dating = 'sample1,sample2,sample3'
    rerun_tip_dating        = ''

    // joint_tree mode only: path to Results_ageSummary.csv from a previous run.
    // Example:
    // age_summary_file = 'results/05_age_summary/run_<timestamp>/Results_ageSummary.csv'
    age_summary_file        = ''

    /////////////////////////////////////////////////////////////////
    // PARAMETERS
    /////////////////////////////////////////////////////////////////

    // Select whether to TipDating multiple sample or single sample
    single_sample_dating    = 'true'

    // Enter whether to split the partition
    split_partition         = 'false'

    // Substitution model (available options: HKY and GTR)
    // Note: if split_partition is enabled, substitution_model has to provided for each partition separated by comma e.g.,
    // ("tRNA:HKY+G+I, rRNA:HKY+G+I, CDS:HKY+G+I, D_loop:HKY+G")
    substitution_model      = 'HKY'

    // Enter mean for the divergence time to the MRCA
    root_mean               = '5000'

    // Enter standard deviation for the divergence time to the MRCA
    root_stdev              = '5000'

    // Enter the number of MCMC chain length for BEAST
    chain_length            = '1000'

    // Enter how often to log the MCMC progress
    log_every               = '10'

    // Population models - (options: skygrid)
    population_model        = 'skygrid'

    // Clock Model - (options: strict, relaxed)
    clock_model             = 'strict'

    // Enter minimum root offset
    root_offset             = '0'

    // Enter burnin for parsing the BEAST log files
    burnin                  = '10'

    // Figure dimensions (width height in inches) for joint_tree_visualize.py
    figsize_w               = 12
    figsize_h               = 12


    /////////////////////////////////////////////////////////////////
    // OUTPUTS
    /////////////////////////////////////////////////////////////////

    // Enter path to output directory
    outdir             = 'results'

    // Mode of copying results from the work directory, values 'symlink' or 'copy'
    publish_mode       = 'copy'
}


// Nextflow parameters

// Path to work directory for intermediate files
workDir                    = 'work'

// Execute the script using the cached results, useful to continue
// executions that was stopped by an error.
resume                     = true

// If run with -profile conda or -profile mamba, provide path to
// centralized directory with conda environments
conda.cacheDir             = null

// If run with -profile apptainer, provide path to centralized
// directory with apptainer images
apptainer.cacheDir         = null

// Cluster options
params.clusterOptions      = ''

// Compute project ID for HPC cluster
params.project             = ''

