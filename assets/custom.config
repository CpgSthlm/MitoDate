// MitoDate custom configuration template.
//
// Usage:
// 1. Copy this file and fill in the required input paths and parameters.
// 2. Set run_mode to one of: 'tip_dating', 'rerun_samples', 'joint_tree'.
// 3. Run the pipeline with: nextflow run -c custom.config -profile <profile> main.nf
//


params {
    // Name of the workflow run, used for naming output files.
    workflow_run_name       = ''

    /////////////////////////////////////////////////////////////////
    // RUN MODE
    /////////////////////////////////////////////////////////////////

    // Choose which pipeline mode to run.
    // options: 'tip_dating', 'rerun_samples', 'joint_tree'
    // 'tip_dating': Tip-dating workflow for all the samples.
    // This prepares FASTA files, generates XML files, runs BEAST,
    // and collects the dating results into a summary table.
    // 'rerun_samples': Rerun tip-dating only for selected sample
    // IDs using FASTA files already created by a previous tip_dating
    // run. This is useful if only a few samples need to be rerun.
    // 'joint_tree': Build a joint date-calibrated tree after reviewing
    // tip_dating results.
    run_mode        = ''

    /////////////////////////////////////////////////////////////////
    // INPUT FILES
    /////////////////////////////////////////////////////////////////

    // Enter path to the sample metadata file (tab-delimited text file).
    sample_metadata = ''

    // Enter path to the fasta file with multiple sequenced alignment
    fasta = ''

    // Enter path to the priors table file in csv format
    priors = ''

    // Optional files
    // Enter path to the annotation gff file - if partition is enabled
    gff = ''

    /////////////////////////////////////////////////////////////////
    // MODE-SPECIFIC INPUTS
    /////////////////////////////////////////////////////////////////

    // ONLY Mode 2: rerun_samples
    // Provide comma-separated sample IDs to rerun,
    // Example: "sample1,sample2,sample3"
    rerun_samples       = ''

    // ONLY Mode 3: joint_tree
    // Provide path to Results_ageSummary.csv from a previous run.
    age_summary_file    = ''

    // Provide figure dimensions (width height in inches) for the
    // tree visualisation.
    figsize_w               = 12
    figsize_h               = 12

    /////////////////////////////////////////////////////////////////
    // PARAMETERS
    /////////////////////////////////////////////////////////////////

    // Select whether to TipDating multiple samples or single sample
    single_sample_dating    = 'true'

    // Enter whether to split the partition
    split_partition         = 'false'

    // Substitution model (available options: HKY and GTR)
    // Note: if split_partition is enabled, substitution_model has
    // to be provided for each partition separated by comma e.g.,
    // ("tRNA:HKY+G+I, rRNA:HKY+G+I, CDS:HKY+G+I, D_loop:HKY+G")
    substitution_model      = 'HKY'

    // Enter mean for the divergence time to the MRCA
    root_mean               = '5000'

    // Enter standard deviation for the divergence time to the MRCA
    root_stdev              = '5000'

    // Enter the number of MCMC chain length for BEAST
    chain_length            = '1000'

    // Enter how often to log the MCMC progress
    log_every               = '10'

    // Population models - (options: skygrid)
    population_model        = 'skygrid'

    // Clock Model - (options: strict, relaxed)
    clock_model             = 'strict'

    // Enter minimum root offset
    root_offset             = '0'

    // Enter burnin for parsing the BEAST log files
    burnin                  = '10'

    /////////////////////////////////////////////////////////////////
    // OUTPUTS
    /////////////////////////////////////////////////////////////////

    // Enter path to output directory
    outdir             = 'results'

    // Mode of copying results from the work directory,
    // values 'symlink' or 'copy'
    publish_mode       = 'copy'
}


// Nextflow parameters

// Path to work directory for intermediate files
workDir                    = 'work'

// Execute the script using the cached results, useful to continue
// executions that was stopped by an error.
resume                     = true

// If run with -profile conda or -profile mamba, provide path to
// centralized directory with conda environments
conda.cacheDir             = null

// If run with -profile apptainer, provide path to centralized
// directory with apptainer images
apptainer.cacheDir         = null

// Cluster options
params.clusterOptions      = ''

// Compute project ID for HPC cluster (added to -A option for SLURM)
params.project             = ''

